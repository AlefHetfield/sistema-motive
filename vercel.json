{
  "buildCommand": "npm run vercel-build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sistema-motive-api.onrender.com/api/:path*"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "api/data/matriculas.json.gz",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/health",
      "schedule": "*/5 * * * *"
    }
  ]
}
