# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/database?sslmode=require"

# JWT Secret (Change this in production!)
JWT_SECRET="motive-super-secret-key-change-this"

# SMTP Configuration for Email Reports
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Recipients for automated reports
REPORT_RECIPIENTS="email1@example.com,email2@example.com"

# CORS Origin (Frontend URL)
CORS_ORIGIN="https://your-frontend-url.vercel.app"

# Node Environment
NODE_ENV="production"

# Google Maps (chave de servidor restrita à Geocoding API)
GOOGLE_MAPS_API_KEY="your-server-google-maps-key"

# Google Drive (use uma chave para pastas públicas OU uma conta de serviço para pastas privadas)
GOOGLE_DRIVE_API_KEY="your-google-drive-api-key"
GOOGLE_DRIVE_CLIENT_EMAIL="service-account@project.iam.gserviceaccount.com"
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
