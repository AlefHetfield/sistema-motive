generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id                     Int                 @id @default(autoincrement())
  nome                   String?
  cpf                    String?
  imovel                 String?
  corretor               String?
  responsavel            String?
  observacoes            String?
  agencia                String?
  modalidade             String?
  status                 String?
  valorFinanciado        Decimal?            @db.Decimal(15, 2)
  matricula              String?
  cidade                 String?
  venda                  Boolean             @default(false)
  remuneracaoPaga        Boolean             @default(false)
  comissaoPaga           Boolean             @default(false)
  createdAt              DateTime            @default(now()) @map("createdAt")
  ultimaAtualizacao      DateTime?           @updatedAt @map("ultimaAtualizacao")
  dataAssinaturaContrato DateTime?           @db.Date
  ultimoUsuarioAlteracao String?
  emEspera               Boolean             @default(false)
  motivoEspera           String?
  observacaoEspera       String?
  dataRetomada           DateTime?           @db.Date
  pausadoEm              DateTime?
  pausadoPor             String?
  simulacoes             HousingSimulation[]
  contratos              Contract[]
  tasks                  Task[]

  @@map("clients")
}

enum Role {
  ADM
  CORRETOR
  ASSISTENTE
}

model User {
  id                 Int                 @id @default(autoincrement())
  nome               String
  email              String              @unique
  passwordHash       String
  role               Role                @default(CORRETOR)
  isActive           Boolean             @default(true)
  mustChangePassword Boolean             @default(false)
  lastLogin          DateTime?
  createdAt          DateTime            @default(now()) @map("createdAt")
  simulacoesCriadas  HousingSimulation[]
  contratosCriados   Contract[]
  canManageAllTasks Boolean @default(false)
  assignedTasks Task[] @relation("AssignedTasks")
  createdTasks Task[] @relation("CreatedTasks")
  delegatedTasks Task[] @relation("DelegatedTasks")
  taskLists TaskList[]
  taskNotifications TaskNotification[]

  @@map("users")
}

model ActivityLog {
  id           Int      @id @default(autoincrement())
  clientId     Int
  clientNome   String
  action       String // "created", "updated", "status_changed", "deleted"
  statusAntes  String?
  statusDepois String?
  userName     String
  createdAt    DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@map("activity_logs")
}

model HousingSimulation {
  id               Int      @id @default(autoincrement())
  clientId         Int
  createdById      Int?
  createdByName    String
  bank             String
  program          String
  system           String
  propertyValue    Decimal  @db.Decimal(15, 2)
  financed         Decimal  @db.Decimal(15, 2)
  requiredEntry    Decimal  @db.Decimal(15, 2)
  firstInstallment Decimal  @db.Decimal(15, 2)
  term             Int
  effectiveRate    Decimal  @db.Decimal(8, 4)
  quota            Decimal  @db.Decimal(8, 4)
  inputSnapshot    Json
  resultSnapshot   Json
  createdAt        DateTime @default(now())

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt(sort: Desc)])
  @@index([createdById])
  @@map("housing_simulations")
}

model Contract {
  id              Int      @id @default(autoincrement())
  clientId        Int?
  createdById     Int?
  createdByName   String
  templateVersion String   @default("v1")
  buyerName       String
  propertyValue   Decimal  @db.Decimal(15, 2)
  financed        Decimal  @db.Decimal(15, 2)
  contractData    Json
  createdAt       DateTime @default(now())

  client    Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt(sort: Desc)])
  @@index([createdById])
  @@map("contracts")
}

model Property {
  id                    Int      @id @default(autoincrement())
  code                  String?
  title                 String
  description           String?
  additionalInformation String?
  address               String
  city                  String?
  neighborhood          String?
  propertyType          String?
  condition             String?
  status                String   @default("Disponível")
  price                 Float?
  area                  Float?
  landArea              Float?
  landConfiguration     String?
  floor                 Int?
  bedrooms              Int?
  suites                Int?
  bathrooms             Int?
  parkingSpaces         Int?
  photoUrl              String?
  sourceUrl             String?
  driveFolderUrl        String?
  driveCoverFileId      String?
  captador              String?
  ownerName             String?
  ownerWhatsapp         String?
  isFavorite            Boolean  @default(false)
  latitude              Float?
  longitude             Float?
  lastAvailabilityCheck DateTime?
  createdById           Int?
  createdByName         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tasks Task[]

  @@index([status])
  @@index([city])
  @@index([latitude, longitude])
  @@index([driveFolderUrl])
  @@map("properties")
}

model TaskList {
  id Int @id @default(autoincrement())
  name String
  ownerId Int
  shared Boolean @default(false)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks Task[]
  createdAt DateTime @default(now())
  @@index([ownerId])
  @@map("task_lists")
}

model Task {
  id Int @id @default(autoincrement())
  title String
  category String @default("GENERAL")
  socialOrder Int @default(0)
  propertyId Int?
  notes String @default("")
  status String @default("TODO")
  important Boolean @default(false)
  dueDate DateTime? @db.Date
  myDay DateTime? @db.Date
  assigneeId Int
  createdById Int?
  delegatedById Int?
  clientId Int?
  listId Int?
  steps Json @default("[]")
  version Int @default(1)
  completedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignee User @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy User? @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)
  delegatedBy User? @relation("DelegatedTasks", fields: [delegatedById], references: [id], onDelete: SetNull)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  list TaskList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  notifications TaskNotification[]
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  @@index([category, deletedAt, status, socialOrder])
  @@index([propertyId])
  @@index([assigneeId, deletedAt, status])
  @@index([delegatedById, deletedAt, status])
  @@index([clientId])
  @@index([listId])
  @@index([dueDate])
  @@map("tasks")
}

model TaskNotification {
  id Int @id @default(autoincrement())
  recipientId Int
  taskId Int
  actorName String
  kind String @default("ASSIGNED")
  readAt DateTime?
  createdAt DateTime @default(now())
  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([recipientId, id])
  @@index([recipientId, readAt])
  @@index([taskId])
  @@map("task_notifications")
}
